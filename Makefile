.PHONY: schedule run dry

# Параметры пайплайна (дефолты берутся из config.yaml → defaults):
#   make run W=3 C=5      — воркеры и лимит вакансий
#   make dry W=2 C=3      — тот же пайплайн, но без реальных откликов
W ?=
C ?=

# Запустить пайплайн от А до Я (сбор → анализ → письма → отклики) с живым логом шагов
run:
	./hhru-jobs $(if $(W),--w=$(W)) $(if $(C),-c $(C)) --verbose

# Прогон без отправки откликов (проверка вердиктов и писем) с живым логом шагов
dry:
	./hhru-jobs $(if $(W),--w=$(W)) $(if $(C),-c $(C)) --dry-run --verbose

# Запустить планировщик; если уже загружен/выполняется — перезапустить
# (bootout внутри install.sh снимает и активный процесс, и старое расписание)
schedule:
	./scheduler/install.sh
